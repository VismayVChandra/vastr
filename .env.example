# ── Supabase (optional) ──────────────────────────────────────────────
# Leave these unset to run Vastr in local demo mode: auth, wardrobe, and
# outfit data are stored in the browser's localStorage instead, and the
# app seeds itself with a starter wardrobe automatically. Set both to
# switch to real Supabase-backed auth, Postgres storage, and RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── AI (optional) ────────────────────────────────────────────────────
# Leave both unset to use the built-in rule-based stylist and offline
# vision estimator (fully functional, just less precise than a real
# model). Set ONE of the keys below to enable real clothing-photo
# analysis and LLM-generated outfit recommendations.
#
# Gemini is checked first and has a generous free tier — get a free key
# at https://aistudio.google.com/apikey (no billing setup required).
GEMINI_API_KEY=
# Free-tier quotas are per model (about 20 requests/day each), so Vastr tries these in
# order and moves on when one is rate-limited or overloaded. Model names change as
# Google retires them; list what your key can use at /v1beta/models.
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# GEMINI_MODEL=gemini-3.6-flash

# Used only if GEMINI_API_KEY is not set.
ANTHROPIC_API_KEY=
# ANTHROPIC_VISION_MODEL=claude-sonnet-5
# ANTHROPIC_TEXT_MODEL=claude-sonnet-5

# Weather (Open-Meteo) needs no API key and always works.

# ── Bulk photo upload pacing (optional) ──────────────────────────────
# Gemini's free tier allows 5 requests/minute per model. Vastr stays under it
# by holding extra photos and sending a few at a time, packing several photos
# into each request. Raise these only if you are on a paid plan.
# NEXT_PUBLIC_AI_REQUESTS_PER_MINUTE=4
# NEXT_PUBLIC_AI_IMAGES_PER_REQUEST=4
